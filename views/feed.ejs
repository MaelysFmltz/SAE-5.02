<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pixora — Accueil</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/feed.css">
</head>
<body>
  <div class="app-container">
    <header class="navbar">
      <div class="nav-brand">
        <img src="/images/logo.jpg" alt="Pixora Logo" class="nav-logo">
        <span class="nav-title">PIXORA</span>
      </div>

      <div class="nav-user">
        <span class="user-greeting">Bonjour, <strong><%= user.pseudo %></strong></span>

        <!-- Bouton Notifications (inactif pour l'instant) -->
        <button type="button" class="btn-notif-header" title="Notifications (bientôt disponible)" disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
        </button>

        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="btn-logout">Déconnexion</button>
        </form>
      </div>
    </header>

    <main class="feed-container">
      <div class="card">
        <h3>Bienvenue sur Pixora</h3>
        <p>Votre fil d'actualité est prêt. Partagez vos premières photos !</p>
      </div>

      <!-- Section découverte des profils -->
      <section class="discover-section">
        <h4 class="section-title">Découvrir des membres</h4>
        <div class="user-list">
          <% if (typeof suggestions !== 'undefined' && suggestions.length > 0) { %>
            <% suggestions.forEach(function(u) { %>
              <a href="/profile/<%= u.pseudo %>" class="user-card-link">
                <div class="user-mini-avatar">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                </div>
                <div class="user-info">
                  <span class="user-pseudo">@<%= u.pseudo %></span>
                  <% if (u.bio) { %>
                    <span class="user-bio"><%= u.bio.slice(0, 45) %><%= u.bio.length > 45 ? '...' : '' %></span>
                  <% } %>
                </div>
                <span class="view-arrow">›</span>
              </a>
            <% }); %>
          <% } else { %>
            <p class="empty-users">Aucun autre membre inscrit pour le moment.</p>
          <% } %>
        </div>
      </section>
    </main>

    <%- include('navbar') %>
  </div>
</body>
</html>