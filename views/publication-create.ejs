<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle publication - Pixora</title>

    <style>
        body {
            margin: 0;
            background: #111;
            color: white;
            font-family: Arial, sans-serif;
        }

        .create-container {
            max-width: 600px;
            margin: 40px auto;
            padding: 20px;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .publication-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        textarea {
            width: 100%;
            min-height: 150px;
            resize: vertical;
            box-sizing: border-box;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #444;
            background: #1d1d1d;
            color: white;
            font-size: 16px;
        }

        .media-button {
            border: 1px dashed #666;
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            background: #1a1a1a;
        }

        .media-button:hover {
            background: #222;
        }

        button {
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            background: white;
            color: black;
        }

        .back {
            display: block;
            text-align: center;
            color: #aaa;
            text-decoration: none;
            margin-top: 15px;
        }

        #message {
            text-align: center;
        }
    </style>
</head>

<body>

<div class="create-container">

    <h1>Nouvelle publication</h1>

    <form id="publicationForm" class="publication-form">

        <!-- Prévu pour la photo / vidéo -->
        <label class="media-button">
            📷 Ajouter une photo ou une vidéo
            <input
                type="file"
                id="media"
                accept="image/*,video/*"
                hidden
            >
        </label>

        <!-- Texte de la publication -->
        <textarea
            id="contenuPub"
            placeholder="Écris quelque chose..."
        ></textarea>

        <button type="submit">
            Publier
        </button>

    </form>

    <p id="message"></p>

    <a href="/home" class="back">
        ← Retour
    </a>

</div>

<script>
    const form = document.getElementById('publicationForm');
    const message = document.getElementById('message');

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const contenuPub =
            document.getElementById('contenuPub').value.trim();

        if (!contenuPub) {
            message.textContent =
                "Écris quelque chose avant de publier.";
            return;
        }

        try {
            const response = await fetch('/api/publications', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    contenuPub,
                    visibilite: 1
                })
            });

            const data = await response.json();

            if (!response.ok) {
                message.textContent =
                    data.error || "Erreur lors de la publication.";
                return;
            }

            window.location.href = '/home';

        } catch (error) {
            console.error(error);
            message.textContent =
                "Une erreur est survenue.";
        }
    });
</script>

</body>
</html>