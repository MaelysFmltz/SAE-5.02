<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Créer une publication</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 40px 20px;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    main {
      width: 100%;
      max-width: 650px;
      margin: 0 auto;
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    h1 {
      margin-top: 0;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
    }

    textarea {
      width: 100%;
      min-height: 140px;
      resize: vertical;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-family: inherit;
      font-size: 15px;
    }

    input[type="file"] {
      width: 100%;
      padding: 10px 0;
    }

    .field {
      margin-bottom: 25px;
    }

    .info {
      font-size: 14px;
      color: #666;
      margin-top: 5px;
    }

    button {
      width: 100%;
      padding: 13px;
      border: 0;
      border-radius: 8px;
      background: #222;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    #message {
      display: none;
      margin-top: 20px;
      padding: 12px;
      border-radius: 8px;
      white-space: pre-wrap;
    }

    #progressContainer {
      display: none;
      margin-top: 20px;
    }

    progress {
      width: 100%;
      height: 20px;
    }

    .success {
      background: #e5f7e8;
      color: #146b2a;
    }

    .error {
      background: #fde7e7;
      color: #a51d1d;
    }
  </style>
</head>

<body>

<main>

  <h1>Créer une publication</h1>

  <form
    id="postForm"
    method="POST"
    enctype="multipart/form-data"
  >

    <div class="field">

      <label for="contenuPub">
        Texte
      </label>

      <textarea
        id="contenuPub"
        name="contenuPub"
        maxlength="5000"
        placeholder="Écrivez votre publication..."
      ></textarea>

      <div class="info">
        5000 caractères maximum.
      </div>

    </div>


    <div class="field">

      <label for="video">
        Vidéo
      </label>

      <input
        id="video"
        name="video"
        type="file"
        accept=".mp4,.mov,.avi,.webm,video/mp4,video/quicktime,video/x-msvideo,video/webm"
      >

      <div class="info">
        Formats acceptés : MP4, MOV, AVI et WebM.
        Taille maximale : 50 Mo.
        Les vidéos non-WebM seront converties automatiquement.
      </div>

    </div>


    <button
      id="submitButton"
      type="submit"
    >
      Publier
    </button>

  </form>


  <div id="progressContainer">
    <progress
      id="progressBar"
      value="0"
      max="100"
    ></progress>

    <div id="progressText">
      Envoi : 0 %
    </div>
  </div>


  <div id="message"></div>

</main>


<script src="/js/post.js"></script>

</body>
</html>
