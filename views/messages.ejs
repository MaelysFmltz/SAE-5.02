<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messagerie — Pixora</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/messages.css">
</head>
<body>
  <div class="app-container">

    <header class="messages-header">
      <a href="/profile" class="icon-btn" title="Retour au profil">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </a>
      <h1 class="header-title">Messages</h1>
      <div class="header-spacer"></div>
    </header>

    <main class="conversations-list">
      <% if (conversations && conversations.length > 0) { %>
        <% conversations.forEach(conv => { %>
          <a href="/messages/<%= conv.idConversation %>" class="conversation-item">
            <div class="conv-avatar">
              <% if (conv.avatarUrl) { %>
                <img src="<%= conv.avatarUrl %>" alt="">
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              <% } %>
            </div>
            <div class="conv-info">
              <span class="conv-title"><%= conv.titreGroupe || conv.autrePseudo %></span>
              <span class="conv-preview <%= conv.nonLu ? 'unread' : '' %>">
                <%= conv.dernierMessage || 'Aucun message' %>
              </span>
            </div>
            <% if (conv.nonLu) { %>
              <span class="conv-unread-dot"></span>
            <% } %>
          </a>
        <% }) %>
      <% } else { %>
        <p class="empty-conversations">Aucune conversation pour l'instant</p>
      <% } %>
    </main>

    <%- include('navbar') %>
  </div>
</body>
</html>