<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.pseudo %> — Pixora</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile.css?v=11">
  <style>
    .profile-actions-group {
      display: flex;
      gap: 10px;
      width: 100%;
      margin-bottom: 20px;
    }
    .profile-actions-group .btn-follow {
      flex: 1;
      margin-bottom: 0;
    }
    .btn-direct-message {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      color: #f0f0f5;
      font-size: 0.95rem;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 0.15s, border-color 0.15s;
    }
    .btn-direct-message:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.25);
    }
    .btn-report-user {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 8px;
      color: #ef4444;
      font-size: 1rem;
      cursor: pointer;
    }
    .btn-block-user {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      color: #cbd5e1;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-block-user.blocked {
      background: rgba(239, 68, 68, 0.2);
      border-color: #ef4444;
      color: #ef4444;
      width: 100%;
      padding: 10px;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .btn-block-user:hover {
      background: rgba(239, 68, 68, 0.25);
      border-color: #ef4444;
      color: #fca5a5;
    }
    .blocked-profile-message {
      margin: 30px 0;
      padding: 30px 20px;
      text-align: center;
      background: #121318;
      border: 1px dashed #353741;
      border-radius: 12px;
      color: #94a3b8;
    }
    .blocked-profile-message h3 {
      color: #f1f5f9;
      margin-bottom: 8px;
      font-size: 1.1rem;
    }

    /* Modal de signalement */
    .report-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 10000;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
    }
    .report-modal-overlay.open {
      display: flex;
    }
    .report-modal-card {
      width: 90%;
      max-width: 460px;
      background: #17181c;
      border: 1px solid #302c3d;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }
    .report-modal-card h3 {
      margin: 0 0 16px 0;
      color: #f5f5f7;
      font-size: 18px;
    }
    .report-modal-card label {
      display: block;
      color: #a5a7b0;
      font-size: 13px;
      margin-bottom: 6px;
    }
    .report-modal-card select, .report-modal-card textarea {
      width: 100%;
      padding: 10px 12px;
      background: #202229;
      border: 1px solid #353741;
      border-radius: 8px;
      color: #f5f5f7;
      font-size: 14px;
      box-sizing: border-box;
      margin-bottom: 14px;
      outline: none;
    }
    .report-modal-card textarea {
      resize: vertical;
      min-height: 80px;
    }
    .report-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 8px;
    }
    .report-modal-actions button {
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
    }
    .report-btn-cancel {
      background: #2d3039;
      color: #e7e7eb;
    }
    .report-btn-submit {
      background: #ef4444;
      color: #ffffff;
    }
  </style>
</head>

<body>

  <div class="app-container">

    <!-- En-tête -->
    <header class="profile-header" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px;">

      <a href="/home" class="icon-btn" title="Retour à l'accueil">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </a>

      <h1 class="header-title" style="margin: 0; font-size: 18px;"><%= profile.pseudo %></h1>

      <div class="header-actions" style="display: flex; align-items: center; gap: 10px;">
        <% if (typeof user !== 'undefined' && user && ['admin', 'moderator', 'superadmin'].includes(user.role)) { %>
          <a href="/admin" style="background: #2563eb; color: #fff; font-weight: 600; padding: 6px 12px; border-radius: 8px; text-decoration: none; font-size: 13px;" title="Centre d'administration">
            Admin
          </a>
        <% } %>

        <% if (isOwner) { %>
          <a href="/settings" title="Paramètres" style="color: inherit; text-decoration: none; padding: 6px; display: inline-flex;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </a>
        <% } %>
      </div>

    </header>

    <main class="profile-container">

      <!-- 1. Identité -->
      <section class="profile-identity-row">

        <div class="avatar-circle">

          <% if (profile.avatarUrl) { %>

            <img
              src="<%= profile.avatarUrl %>"
              alt="Photo de profil"
              class="avatar-img"
            >

          <% } else { %>

            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>

          <% } %>

        </div>

        <div class="identity-info">

          <div class="pseudo-wrap">

            <span class="profile-pseudo">
              <%= profile.pseudo %>
            </span>

            <% if (profile.role === 'admin') { %>

              <span class="badge badge-admin">
                Admin
              </span>

            <% } else if (profile.role === 'moderateur' || profile.role === 'modo') { %>

              <span class="badge badge-modo">
                Modo
              </span>

            <% } %>

            <span
              class="badge badge-friend"
              id="badge-friend"
              <%= (!isOwner && sontAmis && !(typeof jeLuiBloque !== 'undefined' && jeLuiBloque)) ? '' : 'hidden' %>
            >
              Amis
            </span>

          </div>

          <% if (profile.prenom || profile.nom) { %>

            <p class="real-name">
              <%= [profile.prenom, profile.nom].filter(Boolean).join(' ') %>
            </p>

          <% } %>

        </div>

      </section>

      <% const userIsBlocked = (typeof jeLuiBloque !== 'undefined' && jeLuiBloque); %>
      <% const iAmBlocked = (typeof ilMeBloque !== 'undefined' && ilMeBloque); %>

      <% if (iAmBlocked) { %>

        <div class="blocked-profile-message">
          <h3>Profil inaccessible</h3>
          <p>Vous ne pouvez pas accéder aux informations de ce membre.</p>
        </div>

      <% } else { %>

        <!-- 2. Statistiques -->
        <section class="profile-stats">

          <div class="stat-item">
            <span class="stat-value" id="count-abonnes">
              <%= userIsBlocked ? 0 : ((typeof stats !== 'undefined' && stats.nbAbonnes) ? stats.nbAbonnes : 0) %>
            </span>
            <span class="stat-label">
              Abonnés
            </span>
          </div>

          <div class="stat-item">
            <span class="stat-value" id="count-abonnements">
              <%= userIsBlocked ? 0 : ((typeof stats !== 'undefined' && stats.nbAbonnements) ? stats.nbAbonnements : 0) %>
            </span>
            <span class="stat-label">
              Abonnements
            </span>
          </div>

          <div class="stat-item">
            <span class="stat-value" id="count-amis">
              <%= userIsBlocked ? 0 : ((typeof stats !== 'undefined' && stats.nbAmis) ? stats.nbAmis : 0) %>
            </span>
            <span class="stat-label">
              Amis
            </span>
          </div>

        </section>

        <!-- 3. Biographie -->
        <section class="bio-fullwidth">

          <span class="bio-label">
            À propos de moi
          </span>

          <div class="bio-frame">
            <p>
              <%= profile.bio || 'Aucune biographie rédigée.' %>
            </p>
          </div>

        </section>

        <!-- 4. Actions principales -->
        <% if (isOwner) { %>

          <a href="/profile/edit" class="btn-edit">
            Modifier le profil
          </a>

        <% } else { %>

          <div class="profile-actions-group">
            <% if (userIsBlocked) { %>
              <button
                type="button"
                id="btn-block"
                class="btn-block-user blocked"
                data-target-id="<%= profile.idUser %>"
                data-is-blocked="true"
              >
                Débloquer cet utilisateur
              </button>
            <% } else { %>
              <button
                id="btn-follow"
                class="btn-follow <%= estAbonne ? 'following' : '' %>"
                data-target-id="<%= profile.idUser %>"
                data-following="<%= estAbonne ? 'true' : 'false' %>"
              >
                <%= estAbonne ? 'Ne plus suivre' : 'Suivre' %>
              </button>

              <button
                type="button"
                id="btn-message"
                class="btn-direct-message"
                data-target-id="<%= profile.idUser %>"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>Message</span>
              </button>

              <button
                type="button"
                class="btn-report-user"
                title="Signaler cet utilisateur"
                onclick="ouvrirSignalement('utilisateur', <%= profile.idUser %>)"
              >
                🚩
              </button>

              <button
                type="button"
                id="btn-block"
                class="btn-block-user"
                title="Bloquer cet utilisateur"
                data-target-id="<%= profile.idUser %>"
                data-is-blocked="false"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
              </button>
            <% } %>
          </div>

        <% } %>

        <% if (userIsBlocked) { %>

          <div class="blocked-profile-message">
            <h3>Vous avez bloqué ce compte</h3>
            <p>Vous ne recevrez plus de notifications et ses publications vous sont masquées.</p>
          </div>

        <% } else { %>

          <!-- Bouton Reposts -->
          <button
            type="button"
            class="profile-reposts-tab"
            onclick="toggleReposts()"
          >
            <svg viewBox="0 0 24 24">
              <path d="M17 3 L21 7 L17 11"></path>
              <path d="M21 7 H8 C5.8 7 4 8.8 4 11 C4 13.2 5.8 15 8 15 H10"></path>
              <path d="M7 21 L3 17 L7 13"></path>
              <path d="M3 17 H16 C18.2 17 20 15.2 20 13 C20 10.8 18.2 9 16 9 H14"></path>
            </svg>
            <span>
              Reposts
            </span>
          </button>

          <!-- 5. Publications -->
          <section class="posts-section">

            <div class="posts-title">
              <span id="posts-title">
                Publications
              </span>
            </div>

            <!-- PUBLICATIONS ORIGINALES -->
            <div
              class="profile-posts"
              id="profile-publications"
            >
              <% if (profile.publications && profile.publications.length > 0) { %>
                <% profile.publications.forEach(publication => { %>
                  <%- include('partials/publicationCard', {
                    publication,
                    canDelete: !!isOwner,
                    mediaLinkHref: '/publication/' + publication.idPubli,
                    imgClass: 'profile-post-image',
                    videoClass: 'profile-post-video',
                    linkifyHashtags: typeof linkifyHashtags === 'function' ? linkifyHashtags : null
                  }) %>
                <% }); %>
              <% } else { %>
                <div class="empty-posts">
                  <div class="empty-posts-icon">✦</div>
                  <h3>Aucune publication</h3>
                  <p>Les publications créées apparaîtront ici.</p>
                </div>
              <% } %>
            </div>

            <!-- REPOSTS -->
            <div
              class="profile-posts"
              id="profile-reposts"
              style="display: none;"
            >
              <% if (profile.reposts && profile.reposts.length > 0) { %>
                <% profile.reposts.forEach(publication => { %>
                  <%- include('partials/publicationCard', {
                    publication,
                    canDelete: !!isOwner,
                    mediaLinkHref: '/publication/' + publication.idPubli,
                    imgClass: 'profile-post-image',
                    videoClass: 'profile-post-video',
                    linkifyHashtags: typeof linkifyHashtags === 'function' ? linkifyHashtags : null
                  }) %>
                <% }); %>
              <% } else { %>
                <div class="empty-posts">
                  <div class="empty-posts-icon">✦</div>
                  <h3>Aucun repost</h3>
                  <p>Les publications repartagées apparaîtront ici.</p>
                </div>
              <% } %>
            </div>

          </section>

        <% } %>

      <% } %>

    </main>

    <%- include('navbar') %>

  </div>

  <!-- MODAL SIGNALEMENT UNIVERSEL -->
  <div
    id="report-modal"
    class="report-modal-overlay"
    onclick="fermerSignalement(event)"
  >
    <div
      class="report-modal-card"
      onclick="event.stopPropagation()"
    >
      <h3 id="report-modal-title">Signaler</h3>

      <input type="hidden" id="report-type-contenu" value="">
      <input type="hidden" id="report-id-contenu" value="">

      <label for="report-motif">Motif du signalement :</label>
      <select id="report-motif">
        <option value="spam">Spam ou contenu indésirable</option>
        <option value="harcelement">Harcèlement ou intimidation</option>
        <option value="inapproprie">Contenu inapproprié ou explicite</option>
        <option value="autre">Autre motif</option>
      </select>

      <label for="report-description">Précision (optionnel) :</label>
      <textarea id="report-description" placeholder="Expliquez brièvement la raison du signalement..."></textarea>

      <div class="report-modal-actions">
        <button type="button" class="report-btn-cancel" onclick="fermerSignalement()">Annuler</button>
        <button type="button" class="report-btn-submit" onclick="envoyerSignalement()">Signaler</button>
      </div>
    </div>
  </div>

  <script src="/js/deletePost.js"></script>
  <script src="/js/hashtagSuggest.js"></script>

  <script>
    function ouvrirSignalement(typeContenu, idContenu) {
      document.getElementById('report-type-contenu').value = typeContenu;
      document.getElementById('report-id-contenu').value = idContenu;
      document.getElementById('report-description').value = '';
      document.getElementById('report-modal-title').textContent = 'Signaler ce ' + typeContenu;
      document.getElementById('report-modal').classList.add('open');
    }

    function fermerSignalement(event) {
      if (event && event.target !== event.currentTarget) return;
      document.getElementById('report-modal').classList.remove('open');
    }

    async function envoyerSignalement() {
      const typeContenu = document.getElementById('report-type-contenu').value;
      const idContenu = parseInt(document.getElementById('report-id-contenu').value, 10);
      const motif = document.getElementById('report-motif').value;
      const description = document.getElementById('report-description').value.trim();

      try {
        const response = await fetch('/api/signalements', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({ typeContenu, idContenu, motif, description })
        });

        const data = await response.json();
        if (response.status === 401) return window.location.href = '/login';
        if (!response.ok) return alert(data.error || 'Impossible d’enregistrer le signalement.');

        alert('Votre signalement a bien été transmis à l’équipe de modération.');
        fermerSignalement();
      } catch (error) {
        console.error('Erreur signalement :', error);
        alert('Une erreur est survenue lors de l’envoi du signalement.');
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') fermerSignalement();
    });
  </script>

  <% if (!isOwner) { %>
  <script>
    const btnFollow = document.getElementById('btn-follow');
    const btnMessage = document.getElementById('btn-message');
    const btnBlock = document.getElementById('btn-block');
    const countAbonnesEl = document.getElementById('count-abonnes');
    const countAmisEl = document.getElementById('count-amis');
    const badgeFriendEl = document.getElementById('badge-friend');

    // Gestion du blocage / déblocage
    if (btnBlock) {
      btnBlock.addEventListener('click', async () => {
        const targetId = btnBlock.dataset.targetId;
        const isBlocked = btnBlock.dataset.isBlocked === 'true';

        if (!isBlocked && !confirm('Bloquer cet utilisateur ? Vous ne verrez plus ses publications et vous ne serez plus abonnés.')) {
          return;
        }

        btnBlock.disabled = true;

        try {
          const res = await fetch(`/api/blocks/${targetId}`, {
            method: isBlocked ? 'DELETE' : 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(data.error || 'Erreur lors de l’action de blocage.');
            return;
          }

          // Recharger la page pour appliquer immédiatement les masquages
          window.location.reload();
        } catch (err) {
          console.error(err);
          alert('Erreur réseau.');
        } finally {
          btnBlock.disabled = false;
        }
      });
    }

    // Ouverture conversation directe
    if (btnMessage) {
      btnMessage.addEventListener('click', async () => {
        const idUserDestinataire = Number(btnMessage.dataset.targetId);
        btnMessage.disabled = true;

        try {
          const res = await fetch('/api/conversations/direct', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idUserDestinataire })
          });

          if (!res.ok) {
            const err = await res.json();
            alert(err.error || 'Impossible d’ouvrir la conversation.');
            return;
          }

          const data = await res.json();
          window.location.href = `/messages/${data.idConversation}`;
        } catch (err) {
          console.error('Erreur ouverture discussion :', err);
          alert('Erreur réseau.');
        } finally {
          btnMessage.disabled = false;
        }
      });
    }

    // Gestion suivi / ami
    if (btnFollow) {
      btnFollow.addEventListener('click', async () => {
        const targetId = btnFollow.dataset.targetId;
        const isFollowing = btnFollow.dataset.following === 'true';

        btnFollow.disabled = true;

        try {
          const res = await fetch(`/api/friendships/${targetId}`, {
            method: isFollowing ? 'DELETE' : 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          if (!res.ok) throw new Error();

          const nextState = !isFollowing;
          btnFollow.dataset.following = nextState ? 'true' : 'false';
          btnFollow.textContent = nextState ? 'Ne plus suivre' : 'Suivre';
          btnFollow.classList.toggle('following', nextState);

          if (countAbonnesEl) {
            let currentFollowers = parseInt(countAbonnesEl.textContent, 10) || 0;
            countAbonnesEl.textContent = nextState ? currentFollowers + 1 : Math.max(0, currentFollowers - 1);
          }

          const friendsRes = await fetch(`/api/friendships/${targetId}/amis`);
          if (friendsRes.ok) {
            const friendsData = await friendsRes.json();
            const friendsList = Array.isArray(friendsData) ? friendsData : (friendsData.amis || []);
            if (countAmisEl) countAmisEl.textContent = friendsList.length;

            const myProfileRes = await fetch('/api/profile/me');
            if (myProfileRes.ok) {
              const myData = await myProfileRes.json();
              const amIInFriends = friendsList.some(f => f.idUser === myData.idUser);
              if (badgeFriendEl) badgeFriendEl.style.display = amIInFriends ? '' : 'none';
            }
          }
        } catch (err) {
          console.error(err);
          alert('Impossible de modifier le statut d’abonnement.');
        } finally {
          btnFollow.disabled = false;
        }
      });
    }
  </script>
  <% } %>

  <script>
    // =========================================
    // RÉACTIONS DES PUBLICATIONS
    // =========================================

    async function reactionPublication(
      idPubli,
      type
    ) {

      try {

        const response =
          await fetch(
            '/api/comments/react',
            {
              method: 'POST',

              headers: {
                'Content-Type': 'application/json'
              },

              credentials: 'same-origin',

              body: JSON.stringify({
                idPubli: idPubli,
                type: type
              })

            }
          );


        const data =
          await response.json();


        if (response.status === 401) {

          window.location.href =
            '/login';

          return;

        }


        if (!response.ok) {

          alert(
            data.error ||
            'Erreur lors de la réaction'
          );

          return;

        }


        const article =
          document.querySelector(
            `[data-publication-id="${idPubli}"]`
          );


        if (!article) {
          return;
        }


        const likeButton =
          article.querySelector(
            '.like-action'
          );


        const dislikeButton =
          article.querySelector(
            '.dislike-action'
          );


        if (likeButton) {

          const count =
            likeButton.querySelector(
              '.reaction-count'
            );


          if (count) {

            count.textContent =
              data.likes ?? 0;

          }

        }


        if (dislikeButton) {

          const count =
            dislikeButton.querySelector(
              '.reaction-count'
            );


          if (count) {

            count.textContent =
              data.dislikes ?? 0;

          }

        }


        if (likeButton) {

          likeButton.classList.toggle(
            'active',
            data.userReaction === 'LIKE'
          );

        }


        if (dislikeButton) {

          dislikeButton.classList.toggle(
            'active',
            data.userReaction === 'DISLIKE'
          );

        }

      } catch (error) {

        console.error(
          'Erreur réaction publication :',
          error
        );


        alert(
          'Une erreur est survenue lors de la réaction.'
        );

      }

    }


    // =========================================
    // COMMENTAIRES
    // =========================================

    function ouvrirCommentaires(idPubli) {

      window.location.href =
        `/api/comments/view/${idPubli}`;

    }


    // =========================================
    // REPARTAGE
    // =========================================

    async function repartager(idPubli, button) {

      try {

        const response =
          await fetch(
            `/api/publications/${idPubli}/repartage`,
            {
              method: 'POST',

              headers: {
                'Content-Type': 'application/json'
              },

              body: JSON.stringify({
                visibilite: 1
              })
            }
          );

        const data = await response.json();

        if (!response.ok) {

          throw new Error(
            data.error || 'Erreur lors du repartage'
          );

        }

        if (button) {

          button.classList.toggle(
            'active',
            data.reposted
          );

          button.dataset.reposted =
            data.reposted ? 'true' : 'false';

          const label =
            data.reposted
              ? 'Annuler le repost'
              : 'Reposter';

          button.title = label;
          button.setAttribute('aria-label', label);
        }

      } catch (error) {

        console.error(error);

        alert(
          error.message ||
          'Impossible de repartager cette publication.'
        );

      }

    }


    // =========================================
    // COPIER LE LIEN
    // =========================================

    async function copierLien(idPubli) {

      const url =
        `${window.location.origin}/publication/${idPubli}`;


      try {

        await navigator.clipboard.writeText(url);

        alert(
          'Lien copié !'
        );

      } catch (error) {

        console.error(error);

        alert(
          'Impossible de copier le lien.'
        );

      }

    }



    function toggleReposts() {
      const publications = document.getElementById('profile-publications');
      const reposts = document.getElementById('profile-reposts');
      const title = document.getElementById('posts-title');

      if (!publications || !reposts) return;

      const repostsVisible = reposts.style.display !== 'none';

      if (repostsVisible) {
        publications.style.display = '';
        reposts.style.display = 'none';
        if (title) title.textContent = 'Publications';
      } else {
        publications.style.display = 'none';
        reposts.style.display = 'grid';
        if (title) title.textContent = 'Reposts';
      }
    }
  </script>

  <%- include('partials/remixModal') %>

</body>
</html>