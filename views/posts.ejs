<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Nouvelle publication - Pixora
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/post.css"
    >

</head>


<body>

<div class="app-container">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="post-page-header">

        <div class="post-page-logo">

            <img
                src="/images/logo.jpg"
                alt="Pixora"
            >

            <span>
                PIXORA
            </span>

        </div>


        <div class="post-page-user">

            Bonjour,
            <strong>
                <%= user.pseudo %>
            </strong>


            <form
                action="/api/auth/logout"
                method="POST"
            >

                <button
                    type="submit"
                    class="logout"
                >
                    Déconnexion
                </button>

            </form>

        </div>

    </header>


    <!-- =====================================================
         FORMULAIRE DE PUBLICATION
    ====================================================== -->

    <main class="post-page-main">


        <h1>
            Nouvelle publication
        </h1>


        <section class="upload-box">

            <h2>
                Publier une photo
            </h2>


            <form
                id="upload-form"
            >


                <!-- IMAGE -->

                <div class="form-group">

                    <label for="image">
                        Photo
                    </label>


                    <input
                        type="file"
                        id="image"
                        name="image"
                        accept=".jpg,.jpeg,image/jpeg"
                        required
                    >


                    <!-- PREVISUALISATION -->

                    <div
                        id="preview-container"
                        style="display:none;"
                    >

                        <p>
                            Prévisualisation :
                        </p>


                        <img
                            id="preview"
                            alt="Prévisualisation de l'image"
                        >

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label for="contenuPub">
                        Description
                    </label>


                    <textarea
                        id="contenuPub"
                        name="contenuPub"
                        placeholder="Écrivez quelque chose..."
                    ></textarea>

                </div>


                <!-- VISIBILITÉ -->

                <div class="form-group">

                    <label for="visibilite">
                        Visibilité
                    </label>


                    <select
                        id="visibilite"
                        name="visibilite"
                    >

                        <option value="1">
                            Public
                        </option>

                        <option value="0">
                            Privé
                        </option>

                    </select>

                </div>


                <!-- BOUTON -->

                <button
                    type="submit"
                    class="publish-button"
                >
                    Publier
                </button>


                <div id="message"></div>


            </form>

        </section>


    </main>


    <!-- =====================================================
         NAVIGATION BASSE
    ====================================================== -->

    <%- include('navbar') %>


</div>


<script src="/js/post.js"></script>

</body>

</html>