<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Nouvelle publication - Pixora
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/post.css"
    >

    <link
        rel="stylesheet"
        href="/css/editor.css"
    >

</head>


<body>

<div class="app-container">


    <!-- HEADER -->

    <header class="post-page-header">

        <div class="post-page-logo">

            <img
                src="/images/logo.jpg"
                alt="Pixora"
            >

            <span>
                PIXORA
            </span>

        </div>


        <div class="post-page-user">

            Bonjour,
            <strong>
                <%= user.pseudo %>
            </strong>


            <form
                action="/api/auth/logout"
                method="POST"
            >

                <button
                    type="submit"
                    class="logout"
                >
                    Déconnexion
                </button>

            </form>

        </div>

    </header>


    <!-- CONTENU -->

    <main class="post-page-main">

        <h1>
            Nouvelle publication
        </h1>


        <section class="upload-box">

            <h2>
                Partager une photo ou une vidéo
            </h2>


            <form
                id="upload-form"
            >


                <!-- MEDIA -->

                <div class="form-group">

                    <label for="media">

                        Photo ou vidéo

                    </label>


                    <input
                        type="file"
                        id="media"
                        name="media"
                        accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/ogg,video/quicktime"
                        required
                    >


                    <p class="file-help">

                        Images : JPEG, PNG, WEBP — 20 Mo maximum<br>

                        Vidéos : MP4, WEBM, OGG, MOV — 100 Mo maximum

                    </p>


                    <!-- PREVIEW -->

                    <button
                        type="button"
                        id="open-editor"
                        class="editor-open-button"
                        disabled
                    >
                        ✨ Modifier le média
                    </button>

                    <div
                        id="preview-container"
                        class="preview-container"
                        style="display: none;"
                    >

                        <p class="preview-title">
                            Prévisualisation :
                        </p>

                        <img
                            id="image-preview"
                            src=""
                            alt="Aperçu de l'image"
                            style="display: none;"
                        >

                        <video
                            id="video-preview"
                            controls
                            preload="metadata"
                            style="display: none;"
                        ></video>

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label for="contenuPub">

                        Description

                    </label>


                    <textarea
                        id="contenuPub"
                        name="contenuPub"
                        placeholder="Écrivez quelque chose..."
                    ></textarea>

                </div>


                <!-- VISIBILITÉ -->

                <div class="form-group">

                    <label for="visibilite">

                        Visibilité

                    </label>


                    <select
                        id="visibilite"
                        name="visibilite"
                    >

                        <option value="1">
                            Public
                        </option>

                        <option value="0">
                            Privé
                        </option>

                    </select>

                </div>


                <!-- BOUTON -->

                <button
                    type="submit"
                    class="publish-button"
                >

                    Publier

                </button>


                <div
                    id="message"
                    role="status"
                ></div>


            </form>

        </section>

    </main>


    <!-- ÉDITEUR PHOTO / VIDÉO -->
    <div id="editor-modal" class="editor-modal" hidden>
        <div class="editor-window" role="dialog" aria-modal="true" aria-labelledby="editor-title">
            <header class="editor-header">
                <div>
                    <h2 id="editor-title">Éditeur photo</h2>
                    <span id="editor-file-name" class="editor-status"></span>
                </div>
                <button type="button" id="close-editor" aria-label="Fermer">✕</button>
            </header>

            <div class="editor-toolbar">
                <button type="button" id="editor-undo" disabled>↩ Annuler</button>
                <button type="button" id="editor-redo" disabled>↪ Rétablir</button>
                <button type="button" id="editor-reset">⟳ Réinitialiser</button>
                <button type="button" id="rotate-left">↶ Rotation gauche</button>
                <button type="button" id="rotate-right">↷ Rotation droite</button>
                <button type="button" id="flip-horizontal">↔ Miroir H</button>
                <button type="button" id="flip-vertical">↕ Miroir V</button>
            </div>

            <div id="editor-video-controls" class="editor-video-controls" hidden>
                <button type="button" id="editor-play">▶ Lire</button>
                <input id="editor-timeline" type="range" min="0" max="0" step="0.01" value="0" aria-label="Position de la vidéo">
                <span id="editor-time">00:00 / 00:00</span>
            </div>

            <div class="editor-main">
                <section class="editor-stage">
                    <div class="editor-canvas-wrap">
                        <canvas id="editor-canvas"></canvas>
                        <div id="editor-crop-overlay" class="editor-crop-overlay" hidden></div>
                    </div>
                </section>

                <aside class="editor-panel">
                    <div class="editor-tool-group">
                        <h3>Recadrage</h3>
                        <button type="button" id="crop-start">✂ Commencer</button>
                        <button type="button" id="crop-apply" class="editor-primary">Valider</button>
                        <button type="button" id="crop-cancel">Annuler</button>
                        <p id="crop-hint" class="editor-hint">Cliquez sur « Commencer », puis tracez une zone sur l’image.</p>
                    </div>

                    <div class="editor-tool-group">
                        <h3>Format de la publication</h3>
                        <p id="editor-dimensions" class="editor-standard-size">1150 × 628 px</p>
                        <p class="editor-hint">Photos et vidéos sont exportées dans ce format standard afin de garder la même taille d'affichage sur les publications.</p>
                    </div>

                    <div class="editor-tool-group">
                        <h3>Effets</h3>
                        <label>Luminosité <input id="filter-brightness" data-filter="brightness" type="range" min="0" max="200" value="100"></label>
                        <label>Contraste <input id="filter-contrast" data-filter="contrast" type="range" min="0" max="200" value="100"></label>
                        <label>Saturation <input id="filter-saturation" data-filter="saturation" type="range" min="0" max="200" value="100"></label>
                        <label>N&B <input id="filter-grayscale" data-filter="grayscale" type="range" min="0" max="100" value="0"></label>
                        <label>Sépia <input id="filter-sepia" data-filter="sepia" type="range" min="0" max="100" value="0"></label>
                        <label>Flou <input id="filter-blur" data-filter="blur" type="range" min="0" max="12" value="0"></label>
                        <button type="button" id="filters-apply">Appliquer les effets</button>
                    </div>

                    <div class="editor-tool-group">
                        <h3>Texte</h3>
                        <input id="text-value" type="text" maxlength="120" placeholder="Votre texte...">
                        <label>Couleur <input id="text-color" type="color" value="#ffffff"></label>
                        <button type="button" id="add-text">🔤 Ajouter le texte</button>
                        <p class="editor-hint">Le texte est ajouté au centre. Cliquez dessus puis faites-le glisser pour le déplacer.</p>
                    </div>

                    <div class="editor-tool-group">
                        <h3>Éléments</h3>
                        <select id="element-type">
                            <option value="heart">♥ Cœur</option>
                            <option value="star">★ Étoile</option>
                            <option value="circle">● Cercle</option>
                            <option value="rectangle">■ Carré</option>
                            <option value="emoji">✨ Emoji</option>
                        </select>
                        <input id="element-emoji" type="text" maxlength="4" value="✨" placeholder="Emoji">
                        <label>Couleur <input id="element-color" type="color" value="#d83ca9"></label>
                        <button type="button" id="add-element">➕ Ajouter l’élément</button>
                        <p class="editor-hint">L’élément est ajouté au centre. Cliquez dessus puis faites-le glisser pour le déplacer.</p>
                    </div>

                    <div id="selected-overlay-panel" class="editor-selected-panel" hidden>
                        <h3>Élément sélectionné</h3>
                        <p id="selected-overlay-label" class="editor-hint">Texte sélectionné</p>
                        <label>Couleur <input id="overlay-color" type="color" value="#ffffff"></label>
                        <p class="editor-hint">Vous pouvez aussi déplacer l’élément directement avec la souris ou le doigt sur l’image.</p>
                    </div>

                    <p id="editor-message" class="editor-hint" role="status"></p>
                </aside>
            </div>

            <footer class="editor-footer">
                <span class="editor-status">Les retouches sont réalisées dans votre navigateur.</span>
                <div class="editor-footer-actions">
                    <button type="button" id="cancel-editor">Annuler</button>
                    <button type="button" id="apply-editor" class="editor-primary">✓ Utiliser cette photo</button>
                </div>
            </footer>
        </div>
    </div>

    <!-- NAVIGATION -->

    <%- include('navbar') %>


</div>


<script type="module" src="/js/post.js"></script>

</body>

</html>